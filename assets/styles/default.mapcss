node {
    size: 4;
    color: lightgrey;
}

way {
    color: #404052;
    size: 2.0;
}

way[highway=trunk] way[highway=trunk_link] {
    color: #f9b29c;
    width: 1.5;
}

way[highway=primary] {
    color: #fcd6a4;
    width: 1.5;
}

way[highway=secondary] {
    color: #f7fabf;
    width: 1.5;
}

node[natural=tree] {
    size: 10;
    icon-image: "icons/tree.svg";
}
