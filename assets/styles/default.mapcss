* {
    font-size: 12;
}

node {
    size: 4;
    color: lightgrey;
}

node|z16- {
    text: auto;
}

node|z20-22 {
    text: osm_id();
}

way {
    color: #404052;
    size: 2.0;
    text: auto;
}

way[highway] way[railway] {
    text-position: line;
}

way[highway=trunk] way[highway=trunk_link] {
    color: #f9b29c;
    width: 1.5;
}

way[highway=primary] {
    color: #fcd6a4;
    width: 1.5;
}

way[highway=secondary] {
    color: #f7fabf;
    width: 1.5;
}

node|z16-[natural=tree] {
    size: 10;
    icon-image: "icons/tree.svg";
}

node[natural=tree] {
    color: green
}

area:closed[leisure=golf_course] {
    color: #779c48;
    fill-color: #dff6c188;
}

area:closed[building] {
    fill-color: #dc6e6488;
}
