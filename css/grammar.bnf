function// Source: https://wiki.openstreetmap.org/wiki/MapCSS/0.2/BNF

ruleset      ::= rule | ruleset rule;
rule         ::= selectors declarations | import;
import       ::= AT "import" "url" "(" QUOTED ")" ID ";";
selectors    ::= uSelectors | uSelectors ",";
uSelectors   ::= selector | uSelectors "," selector;
selector     ::= subselector | selector subselector;
subselector  ::= object SPACE | object zoom layer | object zoom tests layer 
				 | maybe_class | "setting" ":" ":" ID;
zoom         ::= "|" "z" range | ;
layer		 ::= ":" ":" ID;
range        ::= NUMBER | NUMBER "-" NUMBER | NUMBER "-" | "-" NUMBER;
tests        ::= test | tests test;
test         ::= "[" condition "]";
condition    ::= tag binary value | "!" tag | tag | tag "?" | tag "?!" | function | "!" function
tag          ::= key | QUOTED 		//  tag ":" key ?
key          ::= ID;
value        ::= ID | REGEX | NUMBER | QUOTED | function
binary       ::= "=" | "!=" | "=~" | "<" | ">" | "<=" | ">=";
unary        ::= "-" | "!" | "?";
maybe_class  ::= class | "!" class;
class        ::= "." ID | ":" ID;
object       ::= "node" | "way" | "relation" | "area" | "line" | "canvas" | "*" | "meta";
declarations ::= declaration | declarations declaration;
declaration  ::= "{" styleset "}" | "{" "}";
styleset     ::= uStyleset | uStyleset ";" ;
uStyleset    ::= rule | uStyleset ";" rule;
rule		 ::= style | classAssign;
style        ::= key ":" specifier;
classAssign  ::= "set" ID;
specifier    ::= named | sizes | colour | url | eval | QUOTED | function;
named        ::= ID;
sizes        ::= size | sizes "," size;
size         ::= NUMBER units;
colour       ::= HASHCOLOUR | "rgb" "(" NUMBER "," NUMBER "," NUMBER ")" | "rgba" "(" NUMBER "," NUMBER "," NUMBER "," NUMBER ")";
url          ::= "url" "(" urlContent ")";
urlContent   ::= QUOTED | eval;
units        ::= "px" | "pt" | "%" | ;
eval         ::= "eval" "(" QUOTED ")";
function 	 ::= ID "(" args ")"
args		 ::= value | args "," value